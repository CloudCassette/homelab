{{!< default}}
{{#post}}
<article class="post-page">
    <header class="post-hero">
        <figure class="cassette-hero">
            {{#if feature_image}}
                <img class="cassette-hero-image" src="{{feature_image}}" alt="{{title}}">
            {{else}}
                <img class="cassette-hero-image" src="{{asset "img/cassette.jpg"}}" alt="Black TDK cassette tape">
            {{/if}}
            <figcaption class="cassette-label">
                <div class="cassette-label-topline">
                    <span>TRACK <span aria-hidden="true">01</span> / {{date format="DD MMM YYYY"}}</span>
                    <span class="cassette-label-spec" aria-hidden="true">CC—90 · HIGH BIAS</span>
                </div>
                <h1 class="cassette-title">{{title}}</h1>
                <span class="cassette-side" aria-hidden="true">SIDE A</span>
            </figcaption>
        </figure>
        <div class="post-meta-row">
            <div class="post-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                <span class="meta-separator" aria-hidden="true">·</span>
                <span>{{reading_time}}</span>
            </div>
            {{#if tags}}
                <ul class="tag-list post-tags" aria-label="Post tags">
                    {{#foreach tags}}<li><a class="tag-chip" href="{{url}}">{{name}}</a></li>{{/foreach}}
                </ul>
            {{/if}}
        </div>
    </header>

    <div class="post-content">
        <div class="content-label"><span class="eyebrow">LINER NOTES</span><span aria-hidden="true">—</span></div>
        <div class="gh-content">{{content}}</div>
    </div>

    <nav class="post-pagination" aria-label="Adjacent posts">
        {{#prev_post}}
            <a class="post-adjacent post-adjacent--previous" href="{{url}}"><span class="eyebrow">← PREVIOUS TRACK</span><span class="adjacent-title">{{title}}</span></a>
        {{/prev_post}}
        {{#next_post}}
            <a class="post-adjacent post-adjacent--next" href="{{url}}"><span class="eyebrow">NEXT TRACK →</span><span class="adjacent-title">{{title}}</span></a>
        {{/next_post}}
    </nav>
</article>
{{/post}}
