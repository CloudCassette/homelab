{{!< default}}
<section class="archive-intro" aria-labelledby="page-title">
    <p class="eyebrow"><span class="record-dot" aria-hidden="true"></span> PERSONAL ARCHIVE</p>
    <h1 id="page-title" class="heading-display">The stack<span class="period">.</span></h1>
    <p class="archive-lede">Songs, shows, and the stories that stick around after the last chord.</p>
</section>

<section class="tracklist-section" aria-labelledby="tracklist-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">RECENT ROTATION</p>
            <h2 id="tracklist-title" class="heading-section">Side A</h2>
        </div>
        <span class="side-index" aria-hidden="true">SIDE&nbsp;A <span>///</span></span>
    </div>

    {{#if posts}}
        <ol class="tape-stack">
            {{#foreach posts}}
                <li class="tape-stack-item">
                    <article class="tape-card">
                        <div class="tape-card-art" aria-hidden="true">
                            {{#if feature_image}}
                                <img src="{{feature_image}}" alt="" loading="lazy">
                            {{else}}
                                <img src="{{asset "img/cassette.jpg"}}" alt="" loading="lazy">
                            {{/if}}
                            <span class="tape-art-index">TRACK {{@number}}</span>
                        </div>
                        <div class="tape-card-label">
                            <p class="tape-label-kicker">PERSONAL ARCHIVE <span>•</span> SIDE A</p>
                            <h3 class="tape-title"><a href="{{url}}">{{title}}</a></h3>
                            {{#if excerpt}}<p class="tape-excerpt">{{excerpt words="28"}}</p>{{/if}}
                            <div class="tape-card-meta">
                                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                            </div>
                            {{#if tags}}
                                <ul class="tape-tag-list" aria-label="Post tags">
                                    {{#foreach tags}}<li><a href="{{url}}">{{name}}</a></li>{{/foreach}}
                                </ul>
                            {{/if}}
                        </div>
                        <div class="tape-mechanism" aria-hidden="true"><span></span><span></span></div>
                    </article>
                </li>
            {{/foreach}}
        </ol>
    {{else}}
        <div class="empty-state">
            <svg class="empty-cassette" viewBox="0 0 112 72" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="106" height="66" rx="6"></rect>
                <rect class="empty-label" x="13" y="12" width="86" height="33" rx="2"></rect>
                <circle cx="34" cy="29" r="8"></circle><circle cx="78" cy="29" r="8"></circle>
                <path d="M42 29h28M35 54h42"></path>
            </svg>
            <h3>The first side is still blank.</h3>
            <p>New notes will land here when the next track is ready.</p>
        </div>
    {{/if}}
</section>

{{pagination}}
